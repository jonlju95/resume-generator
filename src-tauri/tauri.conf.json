{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume generator",
  "version": "0.1.2",
  "identifier": "com.resume-generator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Resume Generator",
        "width": 1116,
        "height": 736
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/templates/*": "templates",
      "../src/templates/personal/*": "templates/personal"
    }
  }
}
